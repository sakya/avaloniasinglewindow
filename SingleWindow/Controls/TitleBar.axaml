<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SingleWindow.Controls.TitleBar">

  <StackPanel>
    <Grid Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar">
      <DockPanel IsHitTestVisible="False"></DockPanel>

      <DockPanel>
        <StackPanel Orientation="Horizontal"
                    DockPanel.Dock="Left"
                    Height="30">

          <Button Name="BackBtn" WindowDecorationProperties.ElementRole="User" Height="30" Width="30" Margin="0" Padding="5" IsVisible="False">
            <Button.Styles>
              <Style Selector="Button /template/ ContentPresenter">
                <Setter Property="CornerRadius" Value="0" />
              </Style>
              <Style Selector="Button:not(:pointerover) /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
            </Button.Styles>
            <mi:MaterialIcon Kind="ArrowLeft" />
          </Button>

          <Image Name="Icon"
                 Source="/Assets/icon.ico"
                 Height="20"
                 Width="20"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 Margin="5,0,5,0" />
          <TextBlock Name="Title"
                     FontSize="16"
                     IsHitTestVisible="False"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel HorizontalAlignment="Right"
                    Orientation="Horizontal">
          <Button Name="MinimizeBtn" WindowDecorationProperties.ElementRole="User" Height="30" Width="46" Padding="0">
            <Button.Styles>
              <Style Selector="Button /template/ ContentPresenter">
                <Setter Property="CornerRadius" Value="0" />
              </Style>
              <Style Selector="Button:not(:pointerover) /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
            </Button.Styles>
            <mi:MaterialIcon Kind="WindowMinimize" />
          </Button>

          <Button Name="MaximizeBtn" WindowDecorationProperties.ElementRole="User" Height="30" Width="46" Padding="0">
            <Button.Styles>
              <Style Selector="Button /template/ ContentPresenter">
                <Setter Property="CornerRadius" Value="0" />
              </Style>
              <Style Selector="Button:not(:pointerover) /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
            </Button.Styles>
            <mi:MaterialIcon Name="MaximizeIcon" Kind="WindowMaximize" />
          </Button>

          <Button Name="CloseBtn" WindowDecorationProperties.ElementRole="User" Height="30" Width="46" Padding="0">
            <Button.Styles>
              <Style Selector="Button /template/ ContentPresenter">
                <Setter Property="CornerRadius" Value="0" />
              </Style>
              <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="DarkRed"/>
              </Style>
              <Style Selector="Button:not(:pointerover) /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
              </Style>
            </Button.Styles>
            <mi:MaterialIcon Kind="WindowClose" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Grid>
  </StackPanel>
</UserControl>
